# Copy these NAMES into Vercel > Project > Settings > Environment Variables.
# Values below are placeholders only. NEVER commit real values to GitHub.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase > Project Settings > API Keys > "service_role" (legacy) or "Secret key" (sb_secret_...)
# SERVER ONLY. Full database access. Never put it in any front-end file.
SUPABASE_SERVICE_ROLE_KEY=PASTE-SERVICE-ROLE-KEY-HERE

# Any long random string (at least 24 characters). Used to hash visitor IPs for rate limiting.
APP_SECRET=PASTE-A-LONG-RANDOM-STRING-HERE

# OPTIONAL. Only set temporarily (min 20 characters) when you need to create or reset an
# administrator account at /setup. Delete it from Vercel afterwards and redeploy.
SETUP_TOKEN=

# OPTIONAL tuning
# REGISTER_RATE_MAX=30        # registrations allowed per hour from one network
# ADMIN_SESSION_HOURS=8       # admin login lifetime (1-24)

# OPTIONAL Google Sheets mirror for new membership registrations.
# Create a Google service account, enable Google Sheets API, and share the target sheet
# with the service account's client_email as Editor. Keep this JSON secret server-side.
GOOGLE_SHEETS_SPREADSHEET_ID=PASTE_SPREADSHEET_ID_HERE
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
GOOGLE_SHEETS_TAB_NAME=Applications

# EASIEST Google Sheets option (no private key): Google Apps Script web app. See README "Google Sheets via Apps Script".
# If GOOGLE_SHEETS_WEBHOOK_URL is set it is used instead of the service-account option above.
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=any-long-random-string
